{
  "manifest_version": 3,
  "name": "News Source Analysis",
  "version": "1.5.1",
  "description": "Shows an analysis and factual reporting of a news site, using Media Bias Fact Check as a reference.",
  "icons": {
    "48": "icon.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ]
    }
  ]
}