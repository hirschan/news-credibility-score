{
  "manifest_version": 2,
  "name": "News Source Analysis",
  "version": "1.5.0",
  "description": "Shows an analysis and factual reporting of a news site, using Media Bias Fact Check as a reference.",
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}